{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "pages/**/*",
    "tests/**/*",
    "fixtures/**/*",
    "utils/**/*",
    "playwright.config.ts",
    "scripts/**/*",
    "eslint.config.ts",
    "schemas/**/*"
  ]
}
