# Environment configuration for Local & CI Dual-Engine Automation Testing
NODE_ENV=test
PORT=3000

# Database Configuration (PostgreSQL 18)
DB_DATABASE=ticket_booking
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_URL=postgresql://postgres:postgrespassword@localhost:5432/ticket_booking?sslmode=disable
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ticket_booking?sslmode=disable
DB_LOGGING=false
DB_MIGRATIONS_RUN=false
DB_SYNCHRONIZE=true

# Cache & Lock Configuration (Redis 8)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=skibiditoilet-tungtungshahu-@369-the-best-secrect
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment & Email Third-Party Mocks
RESEND_API_KEY=re_dummy_key_for_staging_testing_123456789
EMAIL_FROM=Ticket Booking <support@ticketbooking.ngxc.io.vn>
PAYOS_CLIENT_ID=mock_client_id
PAYOS_API_KEY=mock_api_key
PAYOS_CHECKSUM_KEY=mock_checksum_key

# Host & Routing Domains
FRONTEND_URL=http://localhost:3000
DOMAIN_NAME=http://localhost:3000
TARGET_URL=http://127.0.0.1:3000
SHOW_CREATION_MIN_LEAD_MINUTES=10
LOG_LEVEL=debug
SENTRY_DSN=""
SENTRY_ENVIRONMENT=test
SENTRY_TRACES_SAMPLE_RATE=1.0
VUS=500

# Playwright Test URLs
API_BASE_URL=http://127.0.0.1:3000
WEB_BASE_URL=https://www.saucedemo.com
